# Supabase (https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database — Supabase PostgreSQL direct connection (Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Vercel Cron — protects /api/cron/* (Vercel sends it as a Bearer token). Any long random string.
CRON_SECRET=

# Cloudinary (https://cloudinary.com → Dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
NEXT_PUBLIC_CLOUDINARY_URL=https://res.cloudinary.com/your_cloud_name/image/upload

# Admin bootstrap (scripts/create-admin.ts) — optional, only needed to create the first admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use_a_strong_password
# Set to 1 only if you must use a password shorter than 12 characters (not recommended)
ADMIN_ALLOW_WEAK_PASSWORD=0

# AI features (Vercel AI Gateway). Local dev only: production authenticates with
# OIDC, and a key set there always overrides OIDC, so never add it to Vercel.
# AI_GATEWAY_API_KEY=
# Kill switches: set to 1 to show staff / public AI features; unset hides them.
# AI_STAFF_ENABLED=
# AI_PUBLIC_ENABLED=

# OpenCode / Stitch MCP (optional, only for Stitch design tooling)
STITCH_API_KEY=your_stitch_api_key_here